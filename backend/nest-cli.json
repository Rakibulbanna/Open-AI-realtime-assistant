{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "projects": {
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "file-upload": {
      "type": "library",
      "root": "libs/file-upload",
      "entryFile": "index",
      "sourceRoot": "libs/file-upload/src",
      "compilerOptions": {
        "tsConfigPath": "libs/file-upload/tsconfig.lib.json"
      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    },
    "send-mailer": {
      "type": "library",
      "root": "libs/send-mailer",
      "entryFile": "index",
      "sourceRoot": "libs/send-mailer/src",
      "compilerOptions": {
        "tsConfigPath": "libs/send-mailer/tsconfig.lib.json"
      }
    }
  }
}