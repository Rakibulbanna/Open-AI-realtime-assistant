{
   "name": "icaddie-backend",
   "version": "0.0.1",
   "description": "",
   "author": "",
   "private": true,
   "license": "UNLICENSED",
   "prisma": {
      "schema": "./prisma/schema.prisma",
      "seed": "ts-node prisma/seed.ts"
   },
   "scripts": {
      "build": "nest build",
      "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
      "start": "nest start",
      "start:dev": "nest start --watch --preserveWatchOutput",
      "start:debug": "nest start --debug --watch --preserveWatchOutput",
      "start:prod": "node dist/src/main",
      "start:dev:poll": "CHOKIDAR_USEPOLLING=true nest start --watch --preserveWatchOutput",
      "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
      "test": "jest",
      "test:watch": "jest --watch",
      "test:cov": "jest --coverage",
      "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
      "test:e2e": "jest --config ./test/jest-e2e.json",
      "docker:dev": "docker-compose up --build",
      "docker:dev:clean": "docker-compose down -v && docker-compose up --build"
   },
   "dependencies": {
      "@nestjs/common": "^11.1.12",
      "@nestjs/core": "^11.1.12",
      "@nestjs/jwt": "^11.0.2",
      "@nestjs/mapped-types": "*",
      "@nestjs/platform-express": "^11.1.12",
      "@nestjs/platform-socket.io": "^11.1.12",
      "@nestjs/platform-ws": "^11.1.12",
      "@nestjs/schedule": "^6.0.1",
      "@nestjs/swagger": "^11.2.5",
      "@nestjs/websockets": "^11.1.12",
      "@openai/agents": "^0.4.4",
      "@openai/agents-realtime": "^0.4.4",
      "@prisma/adapter-pg": "^7.3.0",
      "@prisma/client": "^7.3.0",
      "@types/ioredis": "^5.0.0",
      "@types/ws": "^8.18.1",
      "bcrypt": "^6.0.0",
      "class-transformer": "^0.5.1",
      "class-validator": "^0.14.1",
      "date-fns": "^4.1.0",
      "dotenv": "^17.2.3",
      "ejs": "^4.0.1",
      "exceljs": "^4.4.0",
      "ioredis": "^5.9.2",
      "nodemailer": "^7.0.12",
      "openai": "^6.17.0",
      "pg": "^8.17.2",
      "reflect-metadata": "^0.2.0",
      "rxjs": "^7.8.1",
      "socket.io": "^4.8.3",
      "type": "^2.7.3",
      "uuid": "^13.0.0",
      "zod": "^4.3.5"
   },
   "devDependencies": {
      "@nestjs/cli": "^11.0.16",
      "@nestjs/schematics": "^11.0.9",
      "@nestjs/testing": "^11.1.12",
      "@types/bcrypt": "^6.0.0",
      "@types/ejs": "^3.1.5",
      "@types/express": "^5.0.6",
      "@types/jest": "^30.0.0",
      "@types/multer": "^2.0.0",
      "@types/node": "^25.0.10",
      "@types/nodemailer": "^7.0.5",
      "@types/qrcode": "^1.5.5",
      "@types/speakeasy": "^2.0.10",
      "@types/supertest": "^6.0.0",
      "@types/uuid": "^11.0.0",
      "@typescript-eslint/eslint-plugin": "^8.53.1",
      "@typescript-eslint/parser": "^8.53.1",
      "eslint": "^9.39.2",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-prettier": "^5.5.5",
      "jest": "^30.2.0",
      "prettier": "^3.8.1",
      "prisma": "^7.3.0",
      "rimraf": "^6.0.1",
      "source-map-support": "^0.5.21",
      "supertest": "^7.2.2",
      "ts-jest": "^29.1.0",
      "ts-node": "^10.9.1",
      "tsconfig-paths": "^4.2.0",
      "tsx": "^4.19.4",
      "typescript": "^5.8.3"
   },
   "jest": {
      "moduleFileExtensions": [
         "js",
         "json",
         "ts"
      ],
      "rootDir": ".",
      "testRegex": ".*\\.spec\\.ts$",
      "transform": {
         "^.+\\.(t|j)s$": "ts-jest"
      },
      "collectCoverageFrom": [
         "**/*.(t|j)s"
      ],
      "coverageDirectory": "./coverage",
      "testEnvironment": "node",
      "roots": [
         "<rootDir>/src/",
         "<rootDir>/libs/"
      ],
      "moduleNameMapper": {
         "^./libs/helper(|/.*)$": "<rootDir>/libs/helper/src/$1",
         "^@app/prisma(|/.*)$": "<rootDir>/libs/prisma/src/$1"
      }
   }
}